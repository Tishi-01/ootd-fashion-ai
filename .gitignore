# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Secrets and environment configs
.env
*.env.local

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Test & Benchmark caches
.pytest_cache/
.benchmarks/
.coverage
htmlcov/

# Generated runtime outputs (preserve folders with .gitkeep)
static/crops/*
!static/crops/.gitkeep
static/ghost/*
!static/ghost/.gitkeep
static/masks/*
!static/masks/.gitkeep
debug/*
!debug/.gitkeep
